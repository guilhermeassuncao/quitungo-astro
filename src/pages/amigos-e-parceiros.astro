---
import { getPageAmigosParceiros } from '../utils/api.js';
import Layout from '../layouts/Layout.astro';
import Header from '../components/geral/Header.astro';
import Footer from '../components/geral/Footer.astro';
import Section from '../components/geral/Section.astro';
import Main from '../components/geral/Main.astro';
import Card from '../components/Card.astro';
import CardGridPaginas from '../components/CardGridPaginas.astro';
import TitleMain from '../components/TitleMain.astro';
import Blocos from '../components/Blocos.astro';

const pagina = await getPageAmigosParceiros();
const blocos = pagina?.Conteudo ?? [];
---

<Layout title="Quitungo | Amigos e Parceiros">
    <Main>
        <Header />
        <Section>
            <Card>
                <CardGridPaginas>
                    <TitleMain titulo="Amigos e Parceiros" />
                    {
                        blocos.length > 0 ? (
                            <Blocos blocos={blocos} nomePadrao="Amigos e Parceiros" />
                        ) : (
                            <p class="vazio">Conteúdo em preparação.</p>
                        )
                    }
                </CardGridPaginas>
            </Card>
        </Section>
        <Footer />
    </Main>
</Layout>

<style>
    .vazio {
        @apply text-center text-zinc-400;
    }
</style>
