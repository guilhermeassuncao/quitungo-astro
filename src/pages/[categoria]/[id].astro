---
import { getCategories, getPagesByCategory } from '../../utils/api.js';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/geral/Header.astro';
import Footer from '../../components/geral/Footer.astro';
import Section from '../../components/geral/Section.astro';
import Main from '../../components/geral/Main.astro';
import Card from '../../components/Card.astro';
import CardGridPaginas from '../../components/CardGridPaginas.astro';
import Blocos from '../../components/Blocos.astro';

type Route = {
    slug: string;
    title: string;
    description?: string;
};

export async function getStaticPaths() {
    const routes = await getCategories();
    const paths = [];

    // Uma requisição por categoria; cada post recebe seus próprios dados
    // como props, em vez de a página refazer a busca da categoria inteira.
    for (const route of routes) {
        const paginas = await getPagesByCategory(route.slug);
        for (const pagina of paginas) {
            paths.push({
                params: { categoria: route.slug, id: String(pagina.id) },
                props: { route, pagina },
            });
        }
    }

    return paths;
}

const { route, pagina }: { route: Route; pagina: any } = Astro.props;

const dataPublicacao = new Date(pagina.publishedAt || pagina.createdAt).toLocaleDateString(
    'pt-BR',
    { day: '2-digit', month: 'long', year: 'numeric' }
);

const autoriaLinha = [pagina.Autoria, pagina.Ano].filter(Boolean).join(', ');

const tituloPagina = `Quitungo | ${route.title} - ${pagina.Titulo}`;
---

<Layout title={tituloPagina}>
    <Main>
        <Header />
        <Section>
            <Card>
                <CardGridPaginas>
                    <header class="cabecalho">
                        <a class="categoria" href={`/${route.slug}`}>{route.title}</a>
                        <h1 class="titulo">{pagina.Titulo}</h1>
                        {autoriaLinha && <p class="autoria">{autoriaLinha}</p>}
                        {pagina.Descricao && <p class="resumo">{pagina.Descricao}</p>}
                        <p class="data">Publicado em {dataPublicacao}</p>
                    </header>

                    <Blocos
                        blocos={pagina.Conteudo}
                        nomePadrao={pagina.Titulo}
                        autorPadrao={pagina.Autoria}
                    />

                    {
                        pagina.Referencia && (
                            <footer class="referencia">
                                <span class="referencia-rotulo">Referência</span>
                                <p>{pagina.Referencia}</p>
                            </footer>
                        )
                    }
                </CardGridPaginas>
            </Card>
        </Section>
        <Footer />
    </Main>
</Layout>

<style>
    .cabecalho {
        @apply flex flex-col gap-2 mb-6 pb-6 border-b border-zinc-200;
    }

    .categoria {
        @apply text-sm font-semibold uppercase tracking-wide text-orange-500 hover:text-orange-600 transition;
    }

    .titulo {
        @apply text-2xl md:text-3xl font-black text-zinc-800 leading-tight;
    }

    .autoria {
        @apply text-base font-semibold text-zinc-600;
    }

    .resumo {
        @apply text-lg text-zinc-600 leading-relaxed font-serif;
    }

    .data {
        @apply text-sm text-zinc-400;
    }

    .referencia {
        @apply mt-6 pt-6 border-t border-zinc-200 text-sm text-zinc-500 leading-relaxed;
    }

    .referencia-rotulo {
        @apply block text-xs font-semibold uppercase tracking-wide text-zinc-400 mb-1;
    }
</style>
