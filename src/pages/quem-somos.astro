---
import { getPageQuemSomos } from '../utils/api.js';
import Layout from '../layouts/Layout.astro';
import Header from '../components/geral/Header.astro';
import Footer from '../components/geral/Footer.astro';
import Section from '../components/geral/Section.astro';
import Main from '../components/geral/Main.astro';
import Card from '../components/Card.astro';
import CardGridPaginas from '../components/CardGridPaginas.astro';
import TitleMain from '../components/TitleMain.astro';
import Blocos from '../components/Blocos.astro';

const pagina = await getPageQuemSomos();
const blocos = pagina?.Conteudo ?? [];
---

<Layout title="Quitungo | Quem Somos">
    <Main>
        <Header />
        <Section>
            <Card>
                <CardGridPaginas>
                    <TitleMain titulo="Quem Somos" />
                    <Blocos blocos={blocos} nomePadrao="Quem Somos" />
                </CardGridPaginas>
            </Card>
        </Section>
        <Footer />
    </Main>
</Layout>
